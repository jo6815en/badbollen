// Unit-quaternion formulation: 8 unknowns, 6 dets (bidegree (2,2)) + 2 unit-norm constraints.
LIB "matrix.lib";
ring r = 32003, (a,b,c,d,e,f,g,h), dp;
system("--random", 12345);
proc rotq(poly w, poly x, poly y, poly z)
{
  matrix R[3][3] =
    w^2+x^2-y^2-z^2, 2*(x*y - w*z),   2*(x*z + w*y),
    2*(x*y + w*z),   w^2-x^2+y^2-z^2, 2*(y*z - w*x),
    2*(x*z - w*y),   2*(y*z + w*x),   w^2-x^2-y^2+z^2;
  return(R);
}
matrix R2 = rotq(a,b,c,d); matrix R3 = rotq(e,f,g,h);
ideal I; int k;
for (k = 1; k <= 6; k++)
{
  matrix n1[3][1] = random(-50,50), random(-50,50), random(-50,50);
  matrix n2[3][1] = random(-50,50), random(-50,50), random(-50,50);
  matrix n3[3][1] = random(-50,50), random(-50,50), random(-50,50);
  matrix M = concat(n1, R2*n2, R3*n3);
  I[k] = det(M);
}
I[7] = a^2+b^2+c^2+d^2-1;
I[8] = e^2+f^2+g^2+h^2-1;
int t0 = timer;
ideal J0 = std(I);
"std time (s):", timer - t0;
"dim:", dim(J0), " vdim:", vdim(J0), " GB size:", size(J0);
int mg = 0; for (k = 1; k <= size(J0); k++) { if (deg(J0[k]) > mg) { mg = deg(J0[k]); } }
"max GB element degree:", mg;
ideal K = kbase(J0);
int md = 0; for (k = 1; k <= size(K); k++) { if (deg(K[k]) > md) { md = deg(K[k]); } }
"standard monomials:", size(K), " max degree:", md;
write(":w kbase_unit_gfp.txt", string(K));
t0 = timer;
matrix T;
ideal J = liftstd(I, T);
"liftstd time (s):", timer - t0;
int i; int j; int mdall = 0; int dg;
intvec hist; hist[40] = 0;
for (j = 1; j <= ncols(T); j++)
{
  md = 0;
  for (i = 1; i <= size(I); i++) { if (T[i,j] != 0) { dg = deg(T[i,j]) + deg(I[i]); if (dg > md) { md = dg; } } }
  hist[md+1] = hist[md+1] + 1;
  if (md > mdall) { mdall = md; }
}
"max degree of cofactor*generator:", mdall;
"histogram (index = degree+1):", hist;
quit;
